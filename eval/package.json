{
  "name": "@trialpulse/eval",
  "version": "0.1.0",
  "private": true,
  "description": "TrialPulse Phase 4 golden evaluation suite: deterministic judges and gates run against the local harness (packages/orchestrator/src/local/harness.ts).",
  "type": "commonjs",
  "main": "dist/run-eval.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "npm run build && node dist/run-eval.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@trialpulse/orchestrator": "*",
    "@trialpulse/shared": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.3.0",
    "eslint": "^9.39.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.6"
  }
}
